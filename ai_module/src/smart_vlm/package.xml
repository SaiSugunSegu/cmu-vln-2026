<?xml version="1.0"?>
<package format="3">
  <name>smart_vlm</name>
  <version>0.1.0</version>
  <description>Team AI module: mission supervisor, numerical reasoner, and the
  category-1 evaluation harness. Composes sam_mapper (perception), captioner (Qwen VQA)
  and the vendored tare_planner (exploration) into one per-question launch.</description>
  <maintainer email="team@example.com">CMU-VLN Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- captioner is imported; sam_mapper and tare_planner are launch-time includes /
       topic peers of smart_vlm.launch. -->
  <exec_depend>captioner</exec_depend>
  <exec_depend>sam_mapper</exec_depend>
  <exec_depend>tare_planner</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
