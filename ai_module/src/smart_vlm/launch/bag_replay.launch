#!/usr/bin/env python3
"""Replay a recorded scene bag INSTEAD of the live simulator (offline dev).

Auto-downloads the scene from Google Drive if it's not on disk yet (via
`smart_vlm bag_fetch`, which reads <bags_dir>/scenes.yaml), then plays it. The
bag holds only the allowed inputs (plus /tf, /tf_static). See
docs/M0.5_rosbag_infra.md.

  ros2 launch smart_vlm bag_replay.launch scene:=scene_0
  ros2 launch smart_vlm bag_replay.launch scene:=scene_0 loop:=true  # loop playback (default: single pass)
  ros2 launch smart_vlm bag_replay.launch scene:=scene_0 speed:=0.5  # half speed (ros2 bag play --rate)

Standalone it plays immediately. smart_vlm.launch sets wait_for_armed:=true, which holds
playback until SAM has the question's prompts — see that launch file's ordering notes.

(Python launch file with a .launch name, matching the repo's other launch files.)
"""
import os

from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, ExecuteProcess, OpaqueFunction
from launch.substitutions import LaunchConfiguration


def _play(context, *args, **kwargs):
    scene = LaunchConfiguration("scene").perform(context)
    bags_dir = LaunchConfiguration("bags_dir").perform(context)
    extra = LaunchConfiguration("args").perform(context)
    speed = LaunchConfiguration("speed").perform(context)
    loop = LaunchConfiguration("loop").perform(context)
    wait_for_armed = LaunchConfiguration("wait_for_armed").perform(context)
    armed_timeout = LaunchConfiguration("armed_timeout").perform(context)
    scene_dir = os.path.join(bags_dir, scene)

    # Hold playback until SAM holds this question's real prompts. Without this the bag
    # streams while the detector is still loading weights, so it only ever sees the tail
    # of the scene. `wait_ready` rather than `ros2 topic echo --once`: the gate is
    # latched, and echo's VOLATILE subscriber would miss a sample published before it
    # started and then hang.
    gate = ""
    if wait_for_armed.lower() in ("true", "1"):
        gate = (f"ros2 run smart_vlm wait_ready --topic /pipeline/armed "
                f"--timeout {armed_timeout} && ")

    # --rate is ros2 bag play's own playback-speed flag; kept as a dedicated launch arg
    # (rather than folding it into `args`) since it's the one knob people reach for often.
    rate = f"--rate {speed}"
    loop_flag = "--loop" if loop.lower() in ("true", "1") else ""

    # fetch-if-missing, then play. Resolve the .mcap *after* the fetch and play it
    # directly, so the recorded filename doesn't have to match metadata.yaml (and
    # the scene folder can be renamed freely). Fall back to the bag dir if there
    # isn't exactly one .mcap. `exec` so Ctrl-C reaches the player.
    cmd = (
        f"ros2 run smart_vlm bag_fetch {scene} --bags-dir {bags_dir} && "
        f"{gate}"
        f'{{ mcap="$(ls {scene_dir}/*.mcap 2>/dev/null | head -n1)"; '
        f'if [ -n "$mcap" ]; then exec ros2 bag play "$mcap" -s mcap {rate} {loop_flag} {extra}; '
        f"else exec ros2 bag play {scene_dir} {rate} {loop_flag} {extra}; fi; }}"
    )
    return [ExecuteProcess(cmd=["bash", "-c", cmd], output="screen")]


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument("scene", default_value="scene_0"),
        DeclareLaunchArgument("bags_dir", default_value="/data/bags"),
        DeclareLaunchArgument("args", default_value="",
                              description="extra ros2 bag play flags"),
        DeclareLaunchArgument("speed", default_value="1.0",
                              description="playback rate multiplier (ros2 bag play --rate), "
                                          "e.g. 0.5 = half speed, 2.0 = double speed"),
        DeclareLaunchArgument("loop", default_value="false",
                              description="loop playback (ros2 bag play --loop); "
                                          "default is a single pass"),
        DeclareLaunchArgument("wait_for_armed", default_value="false",
                              description="block until smart_vlm publishes "
                                          "/pipeline/armed before playing, so SAM never "
                                          "misses the front of the scene. Set true by "
                                          "smart_vlm.launch; false keeps standalone "
                                          "`just bag-play` working"),
        DeclareLaunchArgument("armed_timeout", default_value="300.0",
                              description="seconds to wait on /pipeline/armed before "
                                          "giving up (when wait_for_armed)"),
        OpaqueFunction(function=_play),
    ])
