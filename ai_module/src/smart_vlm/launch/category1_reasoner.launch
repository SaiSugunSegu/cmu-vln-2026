<launch>
  <!-- Category-1 (numerical) bag/challenge head: Qwen extract → SAM prompts → best-view VQA. -->
  <arg name="run_id_prefix" default="cat1"/>
  <arg name="vqa_timeout_s" default="120.0"/>
  <arg name="prompts_ack_timeout_s" default="30.0"/>
  <arg name="attribute_max_instances" default="12"/>

  <node pkg="smart_vlm" exec="category1_reasoner" name="category1_reasoner" output="screen">
    <param name="run_id_prefix" value="$(var run_id_prefix)"/>
    <param name="vqa_timeout_s" value="$(var vqa_timeout_s)"/>
    <param name="prompts_ack_timeout_s" value="$(var prompts_ack_timeout_s)"/>
    <param name="attribute_max_instances" value="$(var attribute_max_instances)"/>
  </node>
</launch>
