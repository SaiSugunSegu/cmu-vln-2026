<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>captioner</name>
  <version>0.0.0</version>
  <description>The captioning package.</description>
  <maintainer email="nwzantout@gmail.com">docker</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- captioner.vlm_backends: pydantic defines the structured outputs both backends
       return. openai, the client for the hosted backend, comes from
       docker/requirements_captioner.txt rather than rosdep and is imported lazily, so a
       local-only container still starts without it. -->
  <exec_depend>python3-pydantic</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
